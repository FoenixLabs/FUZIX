package platform-a2560k

disable-pkg platform-a2560k

l /etc/netrc /etc/netrc.orig
r /etc/netrc
f 0644 /etc/netrc userspace/netrc

l /etc/resolv.conf /etc/resolv.orig
r /etc/resolv.conf
f 0644 /etc/resolv.conf userspace/resolv.conf

l /etc/rc /etc/rc.orig
r /etc/rc
f 0755 /etc/rc userspace/rc

d 0755 /usr/share/utils
f 0755 /usr/bin/cfgnet userspace/usr-bin/cfgnet
f 0644 /usr/share/utils/cfgnet.lua userspace/usr-share-utils/cfgnet.lua
